<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About Me | Muhammad Daffa Irsyad Alfathan</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px;

            font-family: Arial, sans-serif;

            /* Brownish background */
            background:
                radial-gradient(
                    circle at 15% 20%,
                    rgba(184, 140, 95, 0.25),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 85% 80%,
                    rgba(120, 78, 48, 0.30),
                    transparent 40%
                ),
                linear-gradient(
                    135deg,
                    #241713,
                    #3a251c,
                    #5a3b2b,
                    #302019
                );

            background-attachment: fixed;

            color: #f4e9dc;
        }


        .container {
            max-width: 900px;
            margin: auto;

            background: rgba(45, 29, 22, 0.90);

            padding: 40px;

            border-radius: 20px;

            border: 1px solid rgba(210, 170, 130, 0.18);

            box-shadow:
                0 15px 50px rgba(0, 0, 0, 0.35);

            backdrop-filter: blur(10px);
        }


        h1 {
            text-align: center;

            margin-bottom: 40px;

            color: #f0d5bb;
        }


        h2 {
            margin-bottom: 15px;

            color: #d8ad88;
        }


        /* ABOUT SECTION */

        .about-container {
            display: flex;

            align-items: center;

            gap: 30px;

            margin-bottom: 40px;

            padding: 25px;

            background:
                linear-gradient(
                    135deg,
                    rgba(100, 66, 46, 0.75),
                    rgba(65, 42, 31, 0.75)
                );

            border-radius: 15px;

            border: 1px solid rgba(220, 180, 140, 0.12);
        }


        .profile-photo {
            width: 200px;
            height: 200px;

            object-fit: cover;

            border-radius: 15px;

            border: 4px solid #8c6448;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, 0.35);
        }


        .about-text {
            flex: 1;
        }


        .about-text p {
            line-height: 1.7;

            color: #d9c8b8;
        }


        /* GENERAL SECTIONS */

        .section {
            margin-bottom: 35px;

            padding: 20px;

            border-radius: 12px;

            background:
                rgba(67, 43, 31, 0.55);

            border: 1px solid rgba(220, 180, 140, 0.08);
        }


        .section p {
            color: #d9c8b8;

            line-height: 1.7;
        }


        li {
            margin-bottom: 10px;

            color: #d9c8b8;
        }


        /* SOCIAL MEDIA */

        .social-links {
            display: flex;

            gap: 15px;

            flex-wrap: wrap;
        }


        .social-link {
            display: flex;

            align-items: center;

            gap: 10px;

            padding: 12px 18px;

            text-decoration: none;

            color: white;

            border-radius: 8px;

            transition: 0.3s;

            box-shadow:
                0 5px 12px rgba(0, 0, 0, 0.20);
        }


        .social-link:hover {
            transform: translateY(-3px);

            opacity: 0.85;
        }


        .youtube {
            background-color: #9e3f3f;
        }


        .tiktok {
            background-color: #211b1b;
        }


        .social-icon {
            width: 22px;

            height: 22px;

            fill: white;
        }


        /* MOBILE */

        @media (max-width: 600px) {

            body {
                padding: 15px;
            }


            .container {
                padding: 25px;
            }


            .about-container {
                flex-direction: column;

                text-align: center;
            }


            .profile-photo {
                width: 180px;

                height: 180px;
            }


            .social-links {
                flex-direction: column;
            }


            .social-link {
                justify-content: center;
            }

        }

    </style>

</head>


<body>


